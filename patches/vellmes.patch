+# ---------------------------------------------------------------------------
+# Compiled pattern for stripping <think>...</think> reasoning blocks and
+# markdown code fences that some models (e.g. GLM) emit around their output.
+# Both are stripped before the response is printed or stored.
+# ---------------------------------------------------------------------------
+_THINK_RE    = re.compile(r'<think>.*?</think>', re.DOTALL | re.IGNORECASE)
+_FENCE_START = re.compile(r'^```[a-zA-Z0-9]*\n', re.MULTILINE)
+_FENCE_END   = re.compile(r'\n```\s*$', re.MULTILINE)
+
+
+def _strip_reasoning(text: str) -> str:
+    """Remove <think>…</think> blocks and outer markdown code fences."""
+    text = _THINK_RE.sub('', text)
+    # Strip a single wrapping ```…``` fence if present
+    text = _FENCE_START.sub('', text, count=1)
+    text = _FENCE_END.sub('', text, count=1)
+    return text.strip()
+
+
+# ---------------------------------------------------------------------------
+# OpenAI client factory — reads key and base_url from environment so that
+# secrets are never stored in files or passed on the command line.
+# ---------------------------------------------------------------------------
+_openai_client = None
+
+
+def _get_client() -> openai.OpenAI:
+    """Return a cached OpenAI-compatible client configured from environment."""
+    global _openai_client
+    if _openai_client is None:
+        api_key  = os.environ.get("OPENAI_API_KEY", "")
+        base_url = os.environ.get("OPENAI_BASE_URL", None)   # None → default api.openai.com
+        kwargs = {"api_key": api_key}
+        if base_url:
+            kwargs["base_url"] = base_url
+        _openai_client = openai.OpenAI(**kwargs)
+    return _openai_client
+
