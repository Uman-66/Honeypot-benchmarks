+def _strip_think_and_fences(text: str | None) -> str:
+    """
+    Pre-process a raw LLM response before JSON parsing.
+
+    Some models (e.g. glm-5p3-flash via Fireworks) emit a <think>…</think>
+    reasoning block before the actual answer.  We strip it first, then strip
+    any leading/trailing markdown code fences so the remainder can be parsed
+    as plain JSON.
+
+    Steps (applied in order):
+      1. Remove <think>…</think> blocks (greedy, dotall).
+      2. Extract the content of the first ```json … ``` fence if present.
+      3. If no fence found, strip any stray leading/trailing ``` lines.
+    """
+    if not text:
+        return ""
+    # Step 1: remove <think> blocks
+    text = re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL | re.IGNORECASE)
+    # Step 2: try to find a ```json ... ``` fence
+    m = re.search(r"```(?:json)?\s*(\[.*?\]|\{.*?\})\s*```", text, re.DOTALL)
+    if m:
+        return m.group(1).strip()
+    # Step 3: no fenced block — strip stray fence markers and return the core
+    text = re.sub(r"^```[a-zA-Z]*\s*", "", text.strip())
+    text = re.sub(r"\s*```$", "", text.strip())
+    return text.strip()
