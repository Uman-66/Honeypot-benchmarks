{"id": "get_wp_login", "method": "GET", "path": "/wp-login.php", "status": 200, "reason": "OK", "response_headers": {"Cache-Control": "no-cache, must-revalidate, max-age=0", "Server": "Apache/2.4.38 (Ubuntu)", "Set-Cookie": "wordpress_test_cookie=WP%20Cookie%20check; path=/", "X-Powered-By": "PHP/7.4.3", "Date": "Sun, 22 Nov 2026 09:34:18 GMT", "Content-Type": "text/html; charset=utf-8", "Transfer-Encoding": "chunked"}, "server_header": "Apache/2.4.38 (Ubuntu)", "content_length_header": null, "actual_body_length": 2262, "content_length_match": null, "chunked": true, "date_header": "Sun, 22 Nov 2026 09:34:18 GMT", "date_drift_s": 0.3, "latency_s": 6.141, "timed_out": false, "error": null, "body": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Log In ‹ My WordPress Site — WordPress</title>\n<link rel=\"stylesheet\" href=\"http://127.0.0.1:8088/wp-admin/css/login.min.css?ver=6.4.2\" />\n<link rel=\"icon\" href=\"http://127.0.0.1:8088/wp-includes/images/w-logo-blue.png?ver=6.4.2\" sizes=\"32x32\" />\n</head>\n<body class=\"login login-action-login wp-core-ui locale-en-us\">\n<div id=\"login\">\n\t<h1><a href=\"https://wordpress.org/\">Powered by WordPress</a></h1>\n\t<form name=\"loginform\" id=\"loginform\" action=\"http://127.0.0.1:8088/wp-login.php\" method=\"post\">\n\t\t<p>\n\t\t\t<label for=\"user_login\">Username or Email Address</label>\n\t\t\t<input type=\"text\" name=\"log\" id=\"user_login\" class=\"input\" value=\"\" size=\"20\" autocapitalize=\"off\" autocomplete=\"username\" />\n\t\t</p>\n\t\t<div class=\"user-pass-wrap\">\n\t\t\t<label for=\"user_pass\">Password</label>\n\t\t\t<div class=\"wp-pwd\">\n\t\t\t\t<input type=\"password\" name=\"pwd\" id=\"user_pass\" class=\"input password-input\" value=\"\" size=\"20\" autocomplete=\"current-password\" />\n\t\t\t\t<button type=\"button\" class=\"wp-hide-pw hide-if-no-js\" data-toggle=\"0\" aria-label=\"Show password\">\n\t\t\t\t\t<span class=\"dashicons dashicons-visibility\" aria-hidden=\"true\"></span>\n\t\t\t\t</button>\n\t\t\t</div>\n\t\t</div>\n\t\t<p class=\"forgetmenot\"><input name=\"rememberme\" type=\"checkbox\" id=\"rememberme\" value=\"forever\" /> <label for=\"rememberme\">Remember Me</label></p>\n\t\t<p class=\"submit\">\n\t\t\t<input type=\"submit\" name=\"wp-submit\" id=\"wp-submit\" class=\"button button-primary button-large\" value=\"Log In\" />\n\t\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"http://127.0.0.1:8088/wp-admin/\" />\n\t\t\t<input type=\"hidden\" name=\"testcookie\" value=\"1\" />\n\t\t</p>\n\t</form>\n\t<p id=\"nav\">\n\t\t<a href=\"http://127.0.0.1:8088/wp-login.php?action=lostpassword\">Lost your password?</a>\n\t</p>\n\t<p id=\"backtoblog\"><a href=\"http://127.0.0.1:8088/\">&larr; Go to My WordPress Site</a></p>\n</div>\n<div class=\"clear\"></div>\n<script type=\"text/javascript\">\nfunction wp_attempt_focus() {setTimeout( function() {try {d = document.getElementById( \"user_login\" );d.focus();d.select();} catch( er ) {}}, 200);}\nwp_attempt_focus();\nif ( typeof wpOnload === 'function' ) { wpOnload() }\n</script>\n</body>\n</html>", "body_sha256": "0761de0655d4cce069d0fb6bce664ad3527feefbd5b468681298f526d7846f39", "target": "galah", "run": 6, "s4_run": 6, "s4_position": 5, "s4_order_seed": 2026, "s4_timing_mode": "http", "s4_wall_start": "2026-11-22T09:33:14.651306+00:00", "s4_harness_ver": "3ffe159"}
