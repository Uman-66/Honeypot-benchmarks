rme\">Remember Me</label>\n\t\t</p>\n\t\t<p class=\"submit\">\n\t\t\t<input type=\"submit\" name=\"wp-submit\" id=\"wp-submit\" class=\"button button-primary button-large\" value=\"Log In\" />\n\t\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"http://127.0.0.1:8088/wp-admin/\" />\n\t\t\t<input type=\"hidden\" name=\"testcookie\" value=\"1\" />\n\t\t</p>\n\t</form>\n\n\t<p id=\"nav\">\n\t\t<a href=\"http://127.0.0.1:8088/wp-login.php?action=lostpassword\">Lost your password?</a>\n\t</p>\n\t<p id=\"backtoblog\">\n\t\t<a href=\"http://127.0.0.1:8088/\">&larr; Go to My WordPress Site</a>\n\t</p>\n</div>\n<script type=\"text/javascript\">\nfunction wp_attempt_focus() {setTimeout( function() {try {d = document.getElementById( \"user_login\" );d.focus();d.select();} catch( er ) {}}, 200);}\nwp_attempt_focus();\nif ( typeof wpOnload === 'function' ) { wpOnload() }\n</script>\n<div class=\"clear\"></div>\n</body>\n</html>", "body_sha256": "ad1b718d62f8b177a8ce9a35f0b2cc08c991cac73ebebc6a2b6aa2ed782288ed", "target": "galah", "run": 8, "s4_run": 8, "s4_position": 5, "s4_order_seed": 2026, "s4_timing_mode": "http", "s4_wall_start": "2026-11-22T10:22:20.602608+00:00", "s4_harness_ver": "3ffe159"}
