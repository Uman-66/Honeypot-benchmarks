ser-pass-wrap\">\n\t\t<label for=\"user_pass\">Password</label>\n\t\t<div class=\"wp-pwd\">\n\t\t\t<input type=\"password\" name=\"pwd\" id=\"user_pass\" class=\"input password-input\" value=\"\" size=\"20\" />\n\t\t\t<button type=\"button\" class=\"button button-secondary wp-hide-pw hide-if-no-js\" data-toggle=\"0\" aria-label=\"Show password\">\n\t\t\t\t<span class=\"dashicons dashicons-visibility\" aria-hidden=\"true\"></span>\n\t\t\t</button>\n\t\t</div>\n\t</div>\n\t\t\t<p class=\"forgetmenot\"><input name=\"rememberme\" type=\"checkbox\" id=\"rememberme\" value=\"forever\" /> <label for=\"rememberme\">Remember Me</label></p>\n\t<p class=\"submit\">\n\t\t<input type=\"submit\" name=\"wp-submit\" id=\"wp-submit\" class=\"button button-primary button-large\" value=\"Log In\" />\n\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"http://127.0.0.1:8088/wp-admin/\" />\n\t\t<input type=\"hidden\" name=\"testcookie\" value=\"1\" />\n\t</p>\n\t</form>\n\n\t\t<p id=\"nav\">\n\t\t<a href=\"http://127.0.0.1:8088/wp-login.php?action=lostpassword\">Lost your password?</a>\n\t</p>\n\t<p id=\"backtoblog\"><a href=\"http://127.0.0.1:8088/\">&#8592; Go to My WordPress Site</a></p>\n</div>\n\n<script type=\"text/javascript\">\nfunction wp_attempt_focus() {setTimeout( function() {try {d = document.getElementById( \"user_login\" );d.focus();d.select();} catch( er ) {}}, 200);}\nwp_attempt_focus();\nif ( typeof wpOnload === 'function' ) { wpOnload() }\n</script>\n\n<div class=\"clear\"></div>\n</body>\n</html>\n", "body_sha256": "d190b20f092ec2a350885c8b349ff8f04c14984beab64b3d2825ba16ee78960a", "target": "galah", "run": 1, "s4_run": 1, "s4_position": 8, "s4_order_seed": 2026, "s4_timing_mode": "http", "s4_wall_start": "2026-11-22T07:59:59.457835+00:00", "s4_harness_ver": "3ffe159"}
