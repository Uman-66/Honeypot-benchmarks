>\n\t\t<button type=\"button\" class=\"wp-hide-pw hide-if-no-js\" data-toggle=\"0\" aria-label=\"Show password\">\n\t\t\t<span class=\"dashicons dashicons-visibility\" aria-hidden=\"true\"></span>\n\t\t</button>\n\t</div>\n</div>\n\t\t<p class=\"forgetmenot\"><input name=\"rememberme\" type=\"checkbox\" id=\"rememberme\" value=\"forever\"  /> <label for=\"rememberme\">Remember Me</label></p>\n\t<p class=\"submit\">\n\t\t<input type=\"submit\" name=\"wp-submit\" id=\"wp-submit\" class=\"button button-primary button-large\" value=\"Log In\" />\n\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"http://127.0.0.1:8088/wp-admin/\" />\n\t\t<input type=\"hidden\" name=\"testcookie\" value=\"1\" />\n\t</p>\n</form>\n\n\t\t<p id=\"nav\">\n\t\t\t<a href=\"http://127.0.0.1:8088/wp-login.php?action=lostpassword\">Lost your password?</a>\n\t\t</p>\n\t\t<p id=\"backtoblog\"><a href=\"http://127.0.0.1:8088/\">\n\t\t\t← Go to My WordPress Site\t\t</a></p>\n\t</div>\n\t<script type=\"text/javascript\">\n\tfunction wp_attempt_focus() {setTimeout( function() {try {d = document.getElementById( \"user_login\" );d.focus();d.select();} catch( er ) {}}, 200);}\nwp_attempt_focus();\nif ( typeof wpOnload === 'function' ) { wpOnload() }</script>\n\t<div class=\"language-switcher\">\n\t\t<form id=\"language-switcher\" method=\"get\">\n\n\t\t\t<label for=\"language-switcher-locales\">Language</label>\n\t\t\t<select name=\"wp_lang\" id=\"language-switcher-locales\"><option value=\"en_US\" selected='selected' data-installed=\"1\">English (United States)</option></select>\n\t\t\t<input type=\"submit\" class=\"button\" value=\"Apply\" />\n\t\t</form>\n\t</div>\n</body>\n</html>\n", "body_sha256": "36aae25e42e67b1dff340dccc291353c62b068a4f56969aa796fa8ce077472f2", "target": "galah", "run": 2, "s4_run": 2, "s4_position": 3, "s4_order_seed": 2026, "s4_timing_mode": "http", "s4_wall_start": "2026-11-22T08:09:40.147911+00:00", "s4_harness_ver": "3ffe159"}
